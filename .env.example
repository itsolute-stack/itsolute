# =============================================================================
# ITSolute Systems — environment variables
# Copy to .env.local for development. Set the same values in Vercel for prod.
# =============================================================================

# Resend — transactional email for contact form
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="ITSolute Systems <hello@itsolute.com>"
RESEND_TO_EMAIL=hello@itsolute.com

# Public contact (used in WhatsApp links, tel: links)
NEXT_PUBLIC_WHATSAPP_NUMBER=918547533005
NEXT_PUBLIC_PHONE_NUMBER=+918547533005

# Analytics (optional — leave blank to skip)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Canonical site URL — used in metadata, sitemap, schema.
# Override to the Vercel URL (e.g. https://itsolute-i68y.vercel.app) while
# itsolute.com is not yet live so search engines don't see a broken canonical.
NEXT_PUBLIC_SITE_URL=https://itsolute.com

# Google reviews on the /lp/* landing pages (Places API New).
# Server-only — do NOT add a NEXT_PUBLIC_ prefix, that would inline the key
# into the client bundle. Unset locally is fine: the badge and reviews
# section simply don't render.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Analytics. Both are public by design (they ship in the client bundle).
# Leave either empty and its script simply does not load.
# GA4 needs no variable here: it is attached to the existing Google tag from
# the Google Analytics UI, so Google injects the destination server-side.
# Microsoft Clarity project ID — the short ID only, not the whole snippet.
NEXT_PUBLIC_CLARITY_ID=

# Meta Pixel ID — digits only, not the whole snippet.
# Unlike the tags above, this one is NOT restricted to production: set it in
# .env.local and the pixel loads on the dev server too, which is the only way
# Events Manager → Test events can see anything before a deploy. That means a
# dev server with this set sends real events to the real pixel, so comment it
# out locally when you are not testing.
NEXT_PUBLIC_META_PIXEL_ID=
